{
  "manifest_version": 3,
  "name": "AI Chat Limit Tracker",
  "version": "2.0.0",
  "description": "Warns before a DeepSeek chat hits its length limit and tracks free-tier usage on ChatGPT, Claude, Gemini and more, with one-click handoff to a new chat.",

  "permissions": ["storage", "clipboardWrite"],

  "host_permissions": [
    "*://chat.deepseek.com/*",
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://copilot.microsoft.com/*",
    "*://grok.com/*",
    "*://www.perplexity.ai/*",
    "*://perplexity.ai/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "AI Chat Limit Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://grok.com/*",
        "*://www.perplexity.ai/*",
        "*://perplexity.ai/*"
      ],
      "js": ["providers.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
